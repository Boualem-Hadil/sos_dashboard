# ── EchoAlert Dashboard — Environment Variables ───────────────────────────────
# Copy this file to .env.local (local dev) or set in Railway (production).
# NEVER commit .env.local — it is covered by .env* in .gitignore.

# ── Backend API ───────────────────────────────────────────────────────────────
# The full public URL of the FastAPI backend (no trailing slash).
# Local dev:   http://localhost:8000
# Production:  https://your-backend.railway.app
NEXT_PUBLIC_API_URL=https://sosbackend-production-c747.up.railway.app

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to use mock data instead of live API calls (dev/testing only).
NEXT_PUBLIC_USE_MOCK=false
